# Copy this file as .env and add your own values.
# Never commit the real .env file to Git.

GEMINI_API_KEY=your_gemini_api_key_here

# Model used for generating text embeddings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Model used later for grounded answer generation.
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# Number of relevant chunks returned during retrieval.
TOP_K=5
